{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node", "chrome"],
    "strict": true,
    // Tests index into arrays at known positions (`tabIds[1]`); checking each is noise.
    "noUncheckedIndexedAccess": false,
    // Playwright's option types don't allow passing `undefined` explicitly.
    "exactOptionalPropertyTypes": false
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
