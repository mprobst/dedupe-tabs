{
  "name": "dedupe-tabs",
  "private": true,
  "version": "1.0.0",
  "description": "A Chrome extension to deduplicate tabs.",
  "author": "Martin Probst",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc -p test",
    "test": "tsc && tsc -p test && node --test 'test/unit/*.test.ts'",
    "build": "tsc",
    "clean": "rm *.js *.js.map *.d.ts *.d.ts.map",
    "watch": "tsc --watch",
    "open-chrome": "open -a 'Google Chrome' chrome://extensions/",
    "bundle": "npm run build && zip -r dedupe-tabs.zip manifest.json background.js background.js.map icon16.png icon48.png icon128.png README.md",
    "test:e2e": "tsc && tsc -p test && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/chrome": "^0.1.27",
    "@types/node": "^24",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
